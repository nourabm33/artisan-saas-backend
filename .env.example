# Application
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:dev_password@localhost:5432/artisan_saas
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3001

# WhatsApp via Twilio (leave empty to log outgoing messages instead of sending)
# Sandbox sender: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Cloudinary (leave empty to store uploads on local disk under UPLOADS_DIR, served at /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOADS_DIR=uploads
