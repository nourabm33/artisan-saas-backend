# Copy to .env.production and fill in. Never commit the real file.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# Public URLs
APP_URL=https://api.example.it
CORS_ORIGIN=https://app.example.it          # comma-separated; '*' is rejected in production
BACKEND_PORT=3000                           # host port bound to the API container

# Image (set by CI; leave default to build locally)
BACKEND_IMAGE=ghcr.io/nourabm33/artisan-saas-backend:latest
APP_RELEASE=dev                             # git SHA / tag, surfaced in /health and Sentry

# PostgreSQL
POSTGRES_DB=artisan_saas
POSTGRES_USER=artisan
POSTGRES_PASSWORD=                          # openssl rand -hex 24
DATABASE_POOL_SIZE=10

# Auth — at least 32 chars, the dev placeholder is rejected
JWT_SECRET=                                 # openssl rand -hex 48
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

LOG_LEVEL=info

# WhatsApp via Twilio (empty = log-only gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Cloudinary (empty = local disk volume, served at $APP_URL/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Abuse protection (per IP per minute)
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_MAX=30

# Monitoring
METRICS_ENABLED=true
METRICS_TOKEN=                              # openssl rand -hex 24 ; Prometheus bearer token for GET /metrics
SENTRY_DSN=                                 # empty = errors only in logs
